# API and worker share one image — they run the same code, only the command
# differs. See docker/docker-compose.yml.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Optional mirrors for networks where deb.debian.org / pypi.org are unreachable:
#   docker compose -f docker/docker-compose.yml build \
#     --build-arg APT_MIRROR=https://mirrors.aliyun.com \
#     --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ api worker
ARG APT_MIRROR=
ARG PIP_INDEX_URL=https://pypi.org/simple/

# git is a runtime dependency, not a build one: module M1 clones repositories.
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|http://deb.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

# Requirements first so a code change does not invalidate the dependency layer.
COPY backend/requirements.txt backend/requirements-dev.txt ./
RUN pip install --upgrade pip && pip install -r requirements-dev.txt

COPY backend/ .

# tree-sitter and networkx come in through requirements.txt. sentence-transformers
# (requirements-analysis.txt) is deliberately NOT installed — torch alone would
# add gigabytes. Install it above once module M6 needs it.

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
