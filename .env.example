# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Relational database (metadata, graph, tours, job state) ---
DATABASE_URL=postgresql+psycopg://codecompass:codecompass@localhost:5432/codecompass

# --- Job queue broker ---
REDIS_URL=redis://localhost:6379/0

# --- Vector store (code embeddings for grounded Q&A) ---
VECTOR_STORE_URL=

# --- Semantic layer (model-agnostic; see F14) ---
# Which provider adapter under app/modules/semantic/providers/ to load.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Storage paths ---
REPO_STORAGE_PATH=./storage/repos
EXPORT_STORAGE_PATH=./storage/exports
