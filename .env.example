# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL: repository metadata, tours, tour steps, job state ---
DATABASE_URL=postgresql+psycopg://codecompass:codecompass@localhost:5432/codecompass

# --- Neo4j: persisted dependency / call graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Chroma: code embeddings for grounded Q&A ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=code_chunks

# --- Celery + Redis: background analysis jobs ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Semantic layer (model-agnostic interface; see F14) ---
# Which provider adapter under app/modules/semantic/providers/ to load.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# sentence-transformers model used for code chunk embeddings
EMBEDDING_MODEL=

# --- Object storage (local filesystem in development) ---
REPO_STORAGE_PATH=./storage/repos
EXPORT_STORAGE_PATH=./storage/exports
